{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Harness": "Data Source=harness.db"
  },
  "Harness": {
    "AdminKey": "",
    "RunWorkers": true,
    "Claude": {
      "Model": "claude-opus-5-5",
      "MaxTurns": 12,
      "MaxTokensPerTurn": 16000,
      "UseServerSideFallback": true
    },
    "Worker": {
      "Concurrency": 4,
      "Lease": "00:05:00",
      "RetryBase": "00:00:05",
      "RetryMax": "00:10:00"
    },
    "Circuit": {
      "FailureThreshold": 5,
      "OpenSeconds": 30
    }
  }
}
