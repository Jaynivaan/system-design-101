{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Harness": "Data Source=harness.db"
  },
  "Harness": {
    "AdminKey": "",
    "RunWorkers": true,
    "Claude": {
      "Model": "claude-opus-5-5",
      "MaxTurns": 12,
      "MaxTokensPerTurn": 16000,
      "UseServerSideFallback": true
    },
    "Worker": {
      "Concurrency": 4,
      "Lease": "00:05:00",
      "RetryBase": "00:00:05",
      "RetryMax": "00:10:00"
    },
    "Circuit": {
      "FailureThreshold": 5,
      "OpenSeconds": 30
    },
    "Voice": {
      "Enabled": false,
      "TenantId": null,
      "PublicBaseUrl": "https://your-tunnel.trycloudflare.com",
      "DefaultLanguage": "ml",
      "TransferNumber": "",
      "Twilio": {
        "AccountSid": "",
        "AuthToken": "",
        "ValidateSignature": true
      },
      "CustomLlm": {
        "BaseUrl": "",
        "Model": "",
        "MaxTokens": 300
      },
      "ClaudeFallback": true,
      "ClaudeModel": "claude-opus-5-5",
      "FirstTokenTimeoutMs": 2500,
      "Stt": {
        "BaseUrl": "http://172.24.224.1:8891",
        "Path": "/asr",
        "Mode": "raw",
        "LanguageQuery": "lang",
        "DefaultLanguage": "ml",
        "SampleRate": 16000,
        "TextProperty": "text",
        "LanguageProperty": "lang"
      },
      "LanguageId": {
        "BaseUrl": "http://172.24.224.1:8891",
        "Path": "/lid",
        "Candidates": [
          "ml",
          "ta",
          "hi"
        ]
      },
      "LocalTts": {
        "BaseUrl": "http://172.24.224.1:8881",
        "Engines": {
          "en": "kokoro",
          "*": "kokoro"
        },
        "Voices": {}
      },
      "GeminiTts": {
        "Model": "gemini-3.8-flash-tts",
        "Voices": {
          "ml": "Kore",
          "*": "Kore"
        }
      },
      "TtsRouting": {
        "ml": [
          "gemini"
        ],
        "*": [
          "local",
          "gemini"
        ]
      }
    }
  }
}